# 虚拟环境 / Python 缓存
venv/
.venv/
__pycache__/
*.pyc

# 向量库:运行时从 docs/ 重建(秒级),不打进镜像
chroma_db/

# 模型:预置进镜像(避免启动时下载拖垮 PaaS 启动超时),但排除冗余的等价权重格式。
# 注:bge-reranker-base 目录同时含 onnx/pytorch/safetensors 三份等价权重(合计 3.2GB),
# 运行时实际只用 pytorch_model.bin,故排除另外两份,省约 2.1GB。
models/*/onnx/
models/*/*.safetensors

# 密钥 / 运行产物
.env
*.env
feedback.json
*.log
run.log

# 隐私文件(本地简历/面试稿,绝不进镜像)
面试讲述.md
简历项目经历.md
项目简介.md

# git / 测试脚本(非运行必需)
.git/
test_*.py
debug_*.py
*_result*.txt
